# ZK Oracle Keeper Configuration
# Copy to .env and fill in values, or use: cargo run --release --bin wizard

# ─── Wallet ───────────────────────────────────────────────────────────────────
# Private key for the keeper wallet. Must have ETH on the oracle chain for gas.
# Check balance: cast balance <address> --rpc-url $RPC_URL
PRIVATE_KEY=0x...

# ─── Chain RPCs ───────────────────────────────────────────────────────────────
# Oracle chain RPC (where the oracle contract lives).
RPC_URL=https://mainnet.base.org

# Source chain RPCs for reading pool state (comma-separated for fallback).
# Using multiple RPCs avoids rate limiting on public endpoints.
BASE_MAINNET_RPC=https://mainnet.base.org,https://base.llamarpc.com,https://1rpc.io/base
SOURCE_CHAIN_ID=8453

# ─── Boundless Market ────────────────────────────────────────────────────────
BOUNDLESS_MARKET_ADDRESS=0xfd152dadc5183870710fe54f939eae3ab9f0fe82
SET_VERIFIER_ADDRESS=0x1Ab08498CfF17b9723ED67143A050c8E8c2e3104
ORDER_STREAM_URL=https://base-mainnet.boundless.network
VERIFIER_ADDRESS=0xa326b2eb45a5c3c206df905a58970dca57b8719e

# ─── Pool / Feed Config ──────────────────────────────────────────────────────
POOL_ADDRESS=0x...
DEX_TYPE=uniswap-v2
PRICE_DECIMALS=18
TOKEN0_DECIMALS=18
TOKEN1_DECIMALS=18
TWAP_WINDOW=1800

# ─── Pricing ─────────────────────────────────────────────────────────────────
# Max price per proof request in ETH. At ~$2000/ETH, 0.00005 ETH ≈ $0.10.
MAX_PRICE=0.00005
# Auction ramp-up period. Longer = more provers see it, lower cost.
# MUST be <= LOCK_TIMEOUT.
RAMP_UP_PERIOD=900
# Total time provers have to deliver the proof. Must be >= RAMP_UP_PERIOD.
LOCK_TIMEOUT=1200

# ─── Triggers ────────────────────────────────────────────────────────────────
HEARTBEAT_SECONDS=3600
CHECK_INTERVAL=3600
DEVIATION_BPS=100

# ─── Sampling ────────────────────────────────────────────────────────────────
# Fewer blocks = fewer RPC calls = less rate limiting risk.
NUM_BLOCKS=5
BLOCK_STRIDE=10

# ─── Guest ELF ───────────────────────────────────────────────────────────────
# Pre-uploaded guest binary URL. Provers download this to generate proofs.
# If unset, the keeper uploads the compiled ELF via the storage uploader.
#
# To upload:
#   curl -F "reqtype=fileupload" -F "fileToUpload=@target/riscv-guest/.../zk-oracle-guest.bin" https://catbox.moe/user/api.php
PROGRAM_URL=https://...

# ─── Storage Uploader ────────────────────────────────────────────────────────
# Used for uploading proof request inputs (~500KB per request).
# The Boundless SDK uses Pinata v3 API which requires a paid plan.
# Workaround: run pinata-proxy.py (v3→v1 translator) and set:
PINATA_API_URL=http://127.0.0.1:8787
PINATA_JWT=...
# For production, use S3 instead:
#   S3_BUCKET=my-bucket
#   S3_PUBLIC_URL=true

# ─── Oracle Contract ─────────────────────────────────────────────────────────
# Set after deploying with: forge script Deploy.s.sol --broadcast
ORACLE_ADDRESS=0x...
IMAGE_ID=0x...
