# ZK Oracle Configuration
# Copy to .env and fill in your values, or use: cargo run --release --bin wizard

# Required
PRIVATE_KEY=0x...
POOL_ADDRESS=0x...
ORACLE_ADDRESS=0x...
RPC_URL=https://mainnet.base.org
PINATA_JWT=your-pinata-jwt

# Pool config
DEX_TYPE=uniswap-v2
PRICE_DECIMALS=18
TOKEN0_DECIMALS=18
TOKEN1_DECIMALS=18

# Sampling
NUM_BLOCKS=5
BLOCK_STRIDE=20

# Keeper triggers
HEARTBEAT_SECONDS=3600
DEVIATION_BPS=100
CHECK_INTERVAL=60

# Boundless Market (Base Mainnet)
BOUNDLESS_MARKET_ADDRESS=0xfd152dadc5183870710fe54f939eae3ab9f0fe82
SET_VERIFIER_ADDRESS=0x1Ab08498CfF17b9723ED67143A050c8E8c2e3104
ORDER_STREAM_URL=https://base-mainnet.boundless.network
VERIFIER_ADDRESS=0xa326b2eb45a5c3c206df905a58970dca57b8719e
